# Local: run `bun run db:start` and copy PUBLISHABLE_KEY from its output.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TMDB (https://www.themoviedb.org/settings/api) — required for trending Movies & Series.
# Preferred: API Read Access Token (v4 Bearer token).
EXPO_PUBLIC_TMDB_READ_TOKEN=
# Optional fallback: v3 API key (used only if EXPO_PUBLIC_TMDB_READ_TOKEN is unset).
EXPO_PUBLIC_TMDB_API_KEY=
