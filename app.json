{
  "expo": {
    "name": "Spark Love",
    "slug": "spark-love",
    "scheme": "sparklove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.sparklove",
      "supportsTablet": false
    },
    "android": {
      "package": "app.sparklove",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C2381F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F1EADB",
          "dark": { "backgroundColor": "#15120E" }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spark Love uses your photos so you can add memories to your shared journal.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
